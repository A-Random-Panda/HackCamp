# Copy to .env for the image service and fill in.
# .env is gitignored. Never commit it, never send these values to the browser.
# The ideas service has its own env file: gemini-ideas/.env.example.

# --- Hack Club AI (image service) ---
# Create a key at https://ai.hackclub.com/dashboard
HACKCLUB_AI_API_KEY=your-api-key-here

# --- Optional image provider settings ---
# HACKCLUB_AI_BASE_URL=https://ai.hackclub.com/proxy/v1
# HACKCLUB_IMAGE_MODEL=google/gemini-nano-banana-2.1

# OPTIONAL. Port the local image server listens on. Default: 8000
PORT=8000

# OPTIONAL. Comma-separated origins allowed to call the image API from a browser.
# Default: * (fine for local hackathon use).
ALLOWED_ORIGINS=*

# --- GUI API endpoints (optional; defaults shown) ---
IDEAS_API_URL=http://127.0.0.1:3000
IMAGE_API_URL=http://127.0.0.1:8000
