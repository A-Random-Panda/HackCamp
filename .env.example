# Copy to .env and fill in.
# .env is gitignored. Never commit it, never send these values to the browser.

# --- Cloudflare (current provider) ---
# Account ID: Cloudflare dashboard -> Workers & Pages -> Account ID (right sidebar)
CLOUDFLARE_ACCOUNT_ID=your-account-id-here
# API token with Workers AI access: My Profile -> API Tokens -> Create Token
CLOUDFLARE_API_TOKEN=your-api-token-here

# --- Google Gemini (previous provider, no image quota on the free tier) ---
GEMINI_API_KEY=

# OPTIONAL. Port the local server listens on. Default: 8000
PORT=8000

# OPTIONAL. Comma-separated origins allowed to call the API from a browser.
# Default: * (fine for local hackathon use).
ALLOWED_ORIGINS=*
