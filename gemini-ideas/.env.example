# Copy this file to gemini-ideas/.env and fill in your Cloudflare credentials.
# Account ID: Cloudflare dashboard -> Workers & Pages -> Account ID.
CLOUDFLARE_ACCOUNT_ID=

# API token with Workers AI permission.
# Create one at https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=

# Optional
# CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# PORT=3000
